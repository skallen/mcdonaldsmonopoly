# Copy the pooled connection string from your Neon project. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/monopoly?sslmode=require
# Optional direct connection, recommended for migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/monopoly?sslmode=require

# Twilio Verify: configure a Verify service with a six-digit SMS code.
# All of these are server-only. Add them to .env.local and your web host.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Stable server-only cookie encryption key. Generate with npm run session:key.
# Copy the generated key from your local file to your web host's secret settings.
SESSION_COOKIE_KEY=
